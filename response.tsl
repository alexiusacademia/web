// web: the answer a handler gives, and the functions that make the usual
// ones: text, HTML, JSON, bytes, redirects and bare statuses.
//
// Author: Alexius Academia
// Date: 2026-11-21

// An answer to a request.
public struct Response {
    status: Int = 200
    // Header names as written; `Content-Length` is added when it's sent.
    headers: [String: String] = [:]
    body: Data = Data()
    // The Set-Cookie lines to send, one for each cookie.
    cookies: [String] = []
    // The session to save, when the `sessions` middleware is used: nil
    // keeps the request's session as it was.
    session: [String: String]? = nil
    // An answer sent in pieces (`web.stream`, `web.events`): what writes
    // them, after the status and headers are sent.
    stream: fn(Stream)? = nil
    // A WebSocket's blocks (`web.webSocket`).
    socket: SocketBlocks? = nil
    // With `session`: whether the session gets a new id (and a new CSRF
    // token), as it should when someone signs in.
    renew: Bool = false

    // A header's value, by its name in any case.
    fn header(_ name: String) -> String? {
        let want = name.lowercase()
        for (key, value) in headers {
            if key.lowercase() == want {
                return value
            }
        }
        nil
    }

    // The same answer with a header set (replacing one of the same name in
    // any case).
    fn withHeader(_ name: String, _ value: String) -> Response {
        var copy = self
        copy.headers = withoutHeader(headers, name)
        copy.headers[name] = value
        copy
    }

    // The same answer with another status.
    fn withStatus(_ status: Int) -> Response {
        var copy = self
        copy.status = status
        copy
    }

    // The same answer, also setting a cookie in the browser. `maxAge` is
    // in seconds (-1: until the browser closes). `sameSite` is "Lax",
    // "Strict" or "None" ("None" needs `secure`).
    fn withCookie(_ name: String, _ value: String, maxAge: Int = -1, path: String = "/",
                  domain: String = "", httpOnly: Bool = true, secure: Bool = false,
                  sameSite: String = "Lax") -> Response {
        var line = "{oneLine(name)}={cookieValue(value)}"
        if maxAge >= 0 {
            line += "; Max-Age={maxAge}"
            line += "; Expires=" + httpDate(now() + Float(maxAge))
        }
        if !path.isEmpty {
            line += "; Path={oneLine(path)}"
        }
        if !domain.isEmpty {
            line += "; Domain={oneLine(domain)}"
        }
        if httpOnly {
            line += "; HttpOnly"
        }
        if secure {
            line += "; Secure"
        }
        if !sameSite.isEmpty {
            line += "; SameSite={oneLine(sameSite)}"
        }
        var copy = self
        copy.cookies = cookies.filter { c in !c.hasPrefix(name + "=") }
        copy.cookies.append(line)
        copy
    }

    // The same answer, also removing a cookie from the browser. `path` and
    // `domain` must be the ones it was set with.
    fn withoutCookie(_ name: String, path: String = "/", domain: String = "") -> Response {
        var line = "{name}=; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT"
        if !path.isEmpty {
            line += "; Path={path}"
        }
        if !domain.isEmpty {
            line += "; Domain={domain}"
        }
        var copy = self
        copy.cookies = cookies.filter { c in !c.hasPrefix(name + "=") }
        copy.cookies.append(line)
        copy
    }

    // The same answer, saving `values` as the session (with the `sessions`
    // middleware). An empty dictionary ends the session. `renew` gives
    // the session a new id: do it when someone signs in, so an id anyone
    // saw before is worthless.
    fn withSession(_ values: [String: String], renew: Bool = false) -> Response {
        var copy = self
        copy.session = values
        copy.renew = renew
        copy
    }

    // The body as text ("" if it isn't UTF-8): for tests.
    fn text() -> String {
        body.text ?? ""
    }
}

// Text, as `text/plain`.
public fn text(_ text: String, status: Int = 200) -> Response {
    Response(status: status, headers: ["Content-Type": "text/plain; charset=utf-8"], body: Data(text: text))
}

// A page of HTML.
public fn html(_ html: String, status: Int = 200) -> Response {
    Response(status: status, headers: ["Content-Type": "text/html; charset=utf-8"], body: Data(text: html))
}

// Any value as JSON: a struct, a list, a dictionary, a number…
public fn json<T>(_ value: T, status: Int = 200) -> Response {
    Response(status: status, headers: ["Content-Type": "application/json"], body: Data(text: toJson(value)))
}

// Bytes, with their content type.
public fn bytes(_ data: Data, type: String = "application/octet-stream", status: Int = 200) -> Response {
    Response(status: status, headers: ["Content-Type": type], body: data)
}

// Sends the browser to another address. 302 (the default) and 303 make
// it ask with GET; 307 and 308 keep the method; 301 and 308 are for good.
public fn redirect(_ to: String, status: Int = 302) -> Response {
    // (A line break would be a second Location: it's encoded instead.)
    Response(status: status, headers: ["Location": to.replace("\r", with: "%0D").replace("\n", with: "%0A")])
}

// A status with a short text body: its reason ("Not Found") unless a
// message is given. 204 and 304 have no body.
public fn status(_ code: Int, _ message: String = "") -> Response {
    if code == 204 || code == 304 || (code >= 100 && code < 200) {
        return Response(status: code)
    }
    let shown = if message.isEmpty { statusText(code) } else { message }
    text(shown, status: code)
}

// The reason phrase of a status: 404 gives "Not Found".
public fn statusText(_ code: Int) -> String {
    match code {
        100 -> "Continue"
        101 -> "Switching Protocols"
        200 -> "OK"
        201 -> "Created"
        202 -> "Accepted"
        204 -> "No Content"
        206 -> "Partial Content"
        301 -> "Moved Permanently"
        302 -> "Found"
        303 -> "See Other"
        304 -> "Not Modified"
        307 -> "Temporary Redirect"
        308 -> "Permanent Redirect"
        400 -> "Bad Request"
        401 -> "Unauthorized"
        403 -> "Forbidden"
        404 -> "Not Found"
        405 -> "Method Not Allowed"
        406 -> "Not Acceptable"
        408 -> "Request Timeout"
        409 -> "Conflict"
        410 -> "Gone"
        411 -> "Length Required"
        412 -> "Precondition Failed"
        413 -> "Content Too Large"
        415 -> "Unsupported Media Type"
        416 -> "Range Not Satisfiable"
        422 -> "Unprocessable Content"
        429 -> "Too Many Requests"
        500 -> "Internal Server Error"
        501 -> "Not Implemented"
        502 -> "Bad Gateway"
        503 -> "Service Unavailable"
        504 -> "Gateway Timeout"
        _ -> "Status {code}"
    }
}

// A time as HTTP writes it: "Sat, 21 Nov 2026 10:28:02 GMT".
public fn httpDate(_ time: Float) -> String {
    formatDate(time, format: "EEE, dd MMM yyyy HH:mm:ss", timeZone: "UTC") + " GMT"
}

// An HTTP date read back, or nil.
public fn parseHttpDate(_ text: String) -> Float? {
    let t = text.trim()
    if t.hasSuffix(" GMT") {
        return parseDate(t.substring(from: 0, to: t.count - 4), format: "EEE, dd MMM yyyy HH:mm:ss", timeZone: "UTC")
    }
    nil
}

// `headers` without any header named `name` in any case.
fn withoutHeader(_ headers: [String: String], _ name: String) -> [String: String] {
    let want = name.lowercase()
    var out: [String: String] = [:]
    for (key, value) in headers {
        if key.lowercase() != want {
            out[key] = value
        }
    }
    out
}

// A cookie's value as sent: characters a cookie can't hold are
// percent-encoded (and read back by `Request.cookies`).
fn cookieValue(_ value: String) -> String {
    var safe = true
    for c in value.characters {
        let code = Data(text: c)[0]
        // (Control characters too: a line break would start another
        // Set-Cookie.)
        if c == ";" || c == "," || c == " " || c == "\"" || c == "\\" || c == "%" || code < 32 || code == 127 {
            safe = false
        }
    }
    if safe {
        return value
    }
    value.urlEncoded
}

// Text without line breaks (for a cookie's name and attributes).
fn oneLine(_ text: String) -> String {
    text.replace("\r", with: "").replace("\n", with: "")
}

// The headers to send: the answer's, plus a Set-Cookie with a line for
// each cookie (Tessel sends each line as a header of its own).
fn wireHeaders(_ response: Response) -> [String: String] {
    var out = withoutHeader(response.headers, "set-cookie")
    if !response.cookies.isEmpty {
        out["Set-Cookie"] = response.cookies.joined(separator: "\n")
    }
    out
}

// ---- Answers in pieces ----

// Where an answer sent in pieces goes: `web.stream { out in … }`.
public struct Stream {
    // The request it answers.
    request: Int

    // Sends text. False once the client has gone.
    fn send(_ text: String) -> Bool {
        sendHTTP(request, data: Data(text: text))
    }

    // Sends bytes. False once the client has gone.
    fn sendData(_ data: Data) -> Bool {
        sendHTTP(request, data: data)
    }

    // Sends a server-sent event (with `web.events`): `data` (each of its
    // lines), with an event name and an id if given.
    fn event(_ data: String, name: String = "", id: String = "") -> Bool {
        var text = ""
        if !name.isEmpty {
            text += "event: {oneLine(name)}\n"
        }
        if !id.isEmpty {
            text += "id: {oneLine(id)}\n"
        }
        // (Every kind of line end ends a line of an event, `\r` alone too.)
        for line in data.replace("\r\n", with: "\n").replace("\r", with: "\n").split("\n") {
            text += "data: {line}\n"
        }
        send(text + "\n")
    }

    // Bytes sent but not yet taken by the client: wait while it grows.
    fn queued() -> Int {
        httpQueued(request)
    }

    // Ends the answer.
    fn end() {
        endHTTP(request)
    }
}

// An answer sent in pieces: `write` gets a `Stream` once the status and
// headers are out, sends what it likes (now or from later blocks), and
// ends it with `end()`. Without a Content-Length it goes in chunks.
public fn stream(type: String = "text/plain; charset=utf-8", status: Int = 200, _ write: fn(Stream)) -> Response {
    Response(status: status, headers: ["Content-Type": type], stream: write)
}

// Server-sent events, which a page reads with `new EventSource(url)`:
// `out.event("…")` sends one.
public fn events(_ write: fn(Stream)) -> Response {
    Response(headers: ["Content-Type": "text/event-stream", "Cache-Control": "no-cache", "X-Accel-Buffering": "no"],
             stream: write)
}

// ---- WebSockets ----

// A WebSocket a route accepted.
public struct WebSocket {
    id: Int

    // Sends a text message. False if it's closed.
    fn send(_ text: String) -> Bool {
        sendWebSocket(id, text: text)
    }

    // Sends a binary message. False if it's closed.
    fn sendData(_ data: Data) -> Bool {
        sendWebSocketData(id, data: data)
    }

    fn close() {
        closeWebSocket(id)
    }
}

// The blocks of a WebSocket (see `web.webSocket`).
public struct SocketBlocks {
    onOpen: fn(WebSocket)
    onMessage: fn(WebSocket, String)
    onData: fn(WebSocket, Data)?
    onClose: fn(WebSocket, String)
    // The sites whose pages may open it ([]: this site's own).
    origins: [String] = []
}

// Turns the request into a WebSocket: `onOpen` when it's open, `onMessage`
// with each text message (and binary ones, as text, without `onData`),
// and `onClose` with why it closed. A request that doesn't ask for a
// WebSocket gets a 400. Middleware runs first, as for any route (a
// session or a password can be required), but the answer that opens the
// WebSocket can't carry headers or cookies of its own.
//
// A page on another site could open it in its visitor's name (with their
// cookies), so only this site's own pages may: a browser's request from
// another site gets a 403. `origins` lists the other sites that may
// ("https://app.example.com"), or `["*"]` for any. Programs that aren't
// browsers send no Origin, and are let in. An open WebSocket stays open
// when its user signs out: close it yourself if that matters.
public fn webSocket(onOpen: fn(WebSocket) = openNothing, onMessage: fn(WebSocket, String),
                    onData: fn(WebSocket, Data)? = nil, onClose: fn(WebSocket, String) = closeNothing,
                    origins: [String] = []) -> Response {
    Response(status: 101, socket: SocketBlocks(onOpen: onOpen, onMessage: onMessage, onData: onData, onClose: onClose,
                                               origins: origins))
}

// A route's WebSocket answer, checked against the request: a 400 if it
// isn't asking for a WebSocket, a 403 from a page of another site.
fn checkedSocket(_ request: Request, _ response: Response) -> Response {
    if let blocks = response.socket {
        let upgrade = (request.header("upgrade") ?? "").lowercase().contains("websocket")
        if !upgrade || request.header("sec-websocket-key") == nil {
            return text("This address takes a WebSocket", status: 400)
        }
        if let origin = request.header("origin") {
            let host = request.header("host") ?? ""
            let own = origin == "http://" + host || origin == "https://" + host
            if !own && !blocks.origins.contains("*") && !blocks.origins.contains(origin) {
                return text("This WebSocket takes pages of its own site only", status: 403)
            }
        }
    }
    response
}

fn openNothing(_ socket: WebSocket) {}

fn closeNothing(_ socket: WebSocket, _ reason: String) {}

// Sends an answer for the request `id`: all at once, in pieces, or as a
// WebSocket.
fn sendAnswer(_ id: Int, _ response: Response) {
    if let blocks = response.socket {
        var ws = -1
        ws = if let onData = blocks.onData {
            acceptWebSocket(id, onMessage: { text in blocks.onMessage(WebSocket(id: ws), text) },
                            onData: { data in onData(WebSocket(id: ws), data) },
                            onClose: { reason in blocks.onClose(WebSocket(id: ws), reason) })
        } else {
            acceptWebSocket(id, onMessage: { text in blocks.onMessage(WebSocket(id: ws), text) },
                            onClose: { reason in blocks.onClose(WebSocket(id: ws), reason) })
        }
        if ws == -1 {
            respondHTTP(id, status: 400, headers: ["Content-Type": "text/plain; charset=utf-8"],
                        body: Data(text: "This address takes a WebSocket"))
        } else {
            blocks.onOpen(WebSocket(id: ws))
        }
        return
    }
    let headers = wireHeaders(response)
    if let write = response.stream {
        if startHTTP(id, status: response.status, headers: headers) {
            write(Stream(request: id))
        }
        return
    }
    respondHTTP(id, status: response.status, headers: headers, body: response.body)
}
