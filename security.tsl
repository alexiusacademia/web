// web: secrets and safety: random tokens, password hashes (PBKDF2), CSRF
// tokens for forms, limits on how often a client may ask, and the
// client's real address behind a proxy.
//
// Author: Alexius Academia
// Date: 2026-11-21

// ---- Random tokens ----

// A source of secret random bytes and tokens (`web.tokens()`).
public struct Tokens {
    take: fn(Int) -> Data
    seeded: fn() -> Bool

    // `count` random bytes.
    fn bytes(_ count: Int) -> Data {
        take(count)
    }

    // `bytes` random bytes as URL-safe base64: 32 bytes give 43
    // characters, for a secret link, a key or an id.
    fn token(bytes: Int = 32) -> String {
        toBase64Url(take(bytes).base64)
    }

    // Whether the system's random bytes have arrived (see `tokens`).
    fn isSeeded() -> Bool {
        seeded()
    }
}

// A source of secret tokens. Tessel 0.23 has no way to read the system's
// secure random numbers directly (tessel#84), so this reads 64 bytes from
// it once, with `od` and /dev/urandom on macOS, Linux and Android and
// .NET's RandomNumberGenerator through PowerShell on Windows, a few
// milliseconds after it's made, while the program runs. Each token is
// then HMAC-SHA256 of a counter, keyed with those bytes and `secret`.
// Tokens asked for before the bytes arrive (or if they can't be read,
// which is reported on the error output) are keyed with `secret` alone,
// with the time and Tessel's `random`: give a long random `secret` and
// make the source when the program starts.
public fn tokens(secret: String = "") -> Tokens {
    var seed = Data()
    var ready = false
    var counter = 0
    var output = ""
    let windows = platform() == "windows"
    let path = if windows { "powershell" } else { "od" }
    let args = if windows {
        ["-NoProfile", "-NonInteractive", "-Command",
         "[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(64))"]
    } else {
        ["-An", "-N64", "-tx1", "-v", "/dev/urandom"]
    }
    runCommand(path: path, args: args, onOutput: { line in
        output += line.trim()
    }) { code in
        if code == 0 {
            let bytes = if windows { decodeBase64(output) ?? Data() } else { hexBytes(output.replace(" ", with: "")) }
            if bytes.count == 64 {
                seed = bytes
                ready = true
            }
        }
        if !ready {
            printError("web: can't read random bytes from the system ({path} gave {code}); tokens rest on the secret alone")
        }
    }
    Tokens(take: { count in
        var out = Data()
        while out.count < count {
            counter += 1
            if ready {
                out += hmac(key: seed + Data(text: secret), message: Data(text: "web token {counter}"))
            } else {
                let mixed = "{counter}:{now()}:{random(0..2147483647)}:{random(0..2147483647)}:{randomFloat()}"
                out += hmac(key: Data(text: secret + ":web tokens"), message: Data(text: mixed))
            }
        }
        out.slice(from: 0, to: count)
    }, seeded: { ready })
}

// Bytes from hexadecimal digits ("0aff"), or fewer if a digit is wrong.
fn hexBytes(_ hex: String) -> Data {
    let chars = hex.characters
    var out = Data()
    var i = 0
    while i + 1 < chars.count {
        let hi = hexDigit(chars[i])
        let lo = hexDigit(chars[i + 1])
        if hi < 0 || lo < 0 {
            return out
        }
        out.append(byte: hi * 16 + lo)
        i += 2
    }
    out
}

// ---- Passwords ----

// PBKDF2 with HMAC-SHA256 (RFC 8018): `length` bytes derived from a
// password and a salt, by `iterations` rounds.
public fn pbkdf2(password: Data, salt: Data, iterations: Int, length: Int = 32) -> Data {
    var k = if password.count > 64 { password.hash() } else { password }
    while k.count < 64 {
        k.append(byte: 0)
    }
    var inner = Data()
    var outer = Data()
    for i in 0..64 {
        inner.append(byte: k[i] ^ 0x36)
        outer.append(byte: k[i] ^ 0x5c)
    }
    var out = Data()
    var block = 1
    while out.count < length {
        var first = salt
        first += Data(bytes: [(block >> 24) & 255, (block >> 16) & 255, (block >> 8) & 255, block & 255])
        var u = (outer + (inner + first).hash()).hash()
        var t = u.bytes
        var n = 1
        while n < iterations {
            u = (outer + (inner + u).hash()).hash()
            for j in 0..32 {
                t[j] = t[j] ^ u[j]
            }
            n += 1
        }
        out += Data(bytes: t)
        block += 1
    }
    out.slice(from: 0, to: length)
}

// The most rounds a password hash may ask for (about 7 seconds).
let maxIterations = 10000000

// A password's hash to store, in Django's form:
// "pbkdf2_sha256$600000$salt$hash" (rounds from 1 to 10,000,000). The
// salt is new each time, so the same password gives a different hash.
// 600,000 rounds take about half a second; on a busy server, use
// `hashPasswordLater`.
public fn hashPassword(_ password: String, iterations: Int = 600000) -> String {
    // A salt only has to be different for each hash, not secret.
    let mixed = Data(text: "{now()}:{random(0..2147483647)}:{random(0..2147483647)}:{randomFloat()}:{password.count}")
    let salt = toBase64Url(mixed.hash().base64).replace("-", with: "a").replace("_", with: "b").substring(from: 0, to: 22)
    let rounds = min(max(iterations, 1), maxIterations)
    let derived = pbkdf2(password: Data(text: password), salt: Data(text: salt), iterations: rounds)
    "pbkdf2_sha256${rounds}${salt}${derived.base64}"
}

// Whether `password` is the one `hash` was made from (by `hashPassword`,
// or Django's pbkdf2_sha256). A hash in another form is false.
public fn checkPassword(_ password: String, _ hash: String) -> Bool {
    let parts = hash.split("$")
    if parts.count != 4 || parts[0] != "pbkdf2_sha256" {
        return false
    }
    if let iterations = Int(parts[1]) {
        if iterations < 1 || iterations > maxIterations {
            return false
        }
        let derived = pbkdf2(password: Data(text: password), salt: Data(text: parts[2]), iterations: iterations)
        return sameText(derived.base64, parts[3])
    }
    false
}

// `hashPassword` on another thread, so other requests aren't held up;
// `done` gets the hash.
public fn hashPasswordLater(_ password: String, iterations: Int = 600000, done: fn(String)) {
    background(work: { job in hashPassword(password, iterations: iterations) }) { hash in
        done(hash)
    }
}

// `checkPassword` on another thread; `done` gets whether it's right.
public fn checkPasswordLater(_ password: String, _ hash: String, done: fn(Bool)) {
    background(work: { job in checkPassword(password, hash) }) { ok in
        done(ok)
    }
}

// ---- CSRF ----

// Stops other sites from sending forms in a signed-in user's name. A
// request with any method but GET, HEAD and OPTIONS must send the CSRF
// token back, as the form field `field` or the header `header`, or it
// gets a 403. Put `web.csrfField(r)` in each form (or send
// `web.csrfToken(r)` in the header from JavaScript).
//
// Where the token is kept: in the session once there is one (use the
// `sessions` middleware before this one), so it belongs to that session
// and a new one comes with `withSession(…, renew: true)` at sign-in;
// before that, in a signed cookie, named `__Host-csrf` over HTTPS (with
// `secure`, or `request.secure` behind `proxy()`) so other sites on the
// same domain can't set it, and `csrf` otherwise.
//
// Use it on the routes of pages and forms, not on an API that other
// programs call.
public fn csrf(secret: String, cookie: String = "", field: String = "_csrf", header: String = "x-csrf-token",
               secure: Bool = false) -> Middleware {
    if secret.count < 16 {
        print("web: a CSRF secret must be at least 16 characters")
        exit(1)
    }
    let key = hmac(key: Data(text: secret), message: Data(text: "web csrf")).hex
    let source = tokens(secret: key)
    let cookieName: fn(Request) -> String = { r in
        if !cookie.isEmpty { cookie } else if secure || r.secure { "__Host-csrf" } else { "csrf" }
    }
    Middleware(before: { request in
        var passed = request
        let inSession = request.session["_csrf"] ?? ""
        var inCookie = ""
        if let raw = request.cookie(cookieName(request)) {
            inCookie = unsign(raw, secret: key) ?? ""
        }
        var token = if inSession.isEmpty { inCookie } else { inSession }
        if token.isEmpty {
            token = source.token()
            passed.values["web.csrf.new"] = "1"
        }
        passed.values["csrf"] = token
        let m = request.method
        if m != "GET" && m != "HEAD" && m != "OPTIONS" {
            let expected = if inSession.isEmpty { inCookie } else { inSession }
            let sent = request.header(header) ?? (request.form()[field] ?? "")
            if expected.isEmpty || sent.isEmpty || !sameText(sent, expected) {
                return Step.stop(response: status(403, "The form is out of date or came from another site: reload the page and try again"))
            }
        }
        Step.next(request: passed)
    }, after: { request, response in
        var r = response
        let token = request.values["csrf"] ?? ""
        // A session being saved keeps its token (a new one at sign-in).
        if let values = response.session {
            if !values.isEmpty && (response.renew || values["_csrf"] == nil) {
                var kept = values
                kept["_csrf"] = if response.renew { source.token() } else { token }
                r.session = kept
            }
            return r
        }
        if request.values["web.csrf.new"] == "1" && request.session.isEmpty {
            let isSecure = secure || request.secure
            return r.withCookie(cookieName(request), sign(token, secret: key), secure: isSecure)
        }
        r
    })
}

// The CSRF token for this request (with the `csrf` middleware).
public fn csrfToken(_ request: Request) -> String {
    request.values["csrf"] ?? ""
}

// A hidden form field with the CSRF token, to put in a form (in a
// template, with `{{{csrf}}}`).
public fn csrfField(_ request: Request, field: String = "_csrf") -> String {
    "<input type=\"hidden\" name=\"{escapeHtml(field)}\" value=\"{escapeHtml(csrfToken(request))}\">"
}

// ---- Rate limits ----

// How many requests a client has made in its current window.
struct RateWindow {
    start: Float
    count: Int
}

// Lets each client make at most `requests` requests every `seconds`;
// more get a 429 with Retry-After. Clients are told apart by `key`: their
// IP address unless you say otherwise (a user's name, an API key); an
// IPv6 address counts by its first half (its /64 network), since one
// client usually has a whole /64.
// Answers carry RateLimit-Limit, RateLimit-Remaining and RateLimit-Reset.
// The counts are kept in memory, for this server only.
public fn rateLimit(requests: Int, seconds: Float, key: fn(Request) -> String = clientIP,
                    maxClients: Int = 100000) -> Middleware {
    var windows: [String: RateWindow] = [:]
    var lastSweep = now()
    Middleware(before: { request in
        let t = now()
        // Forget clients whose window has ended, now and then, and when
        // there are too many (then, if they're all still counting, start
        // again rather than run out of memory).
        if t - lastSweep > max(seconds, 60.0) || windows.count > maxClients {
            var kept: [String: RateWindow] = [:]
            for (k, w) in windows {
                if t - w.start < seconds {
                    kept[k] = w
                }
            }
            windows = if kept.count > maxClients { [:] } else { kept }
            lastSweep = t
        }
        let k = key(request)
        var w = windows[k] ?? RateWindow(start: t, count: 0)
        if t - w.start >= seconds {
            w = RateWindow(start: t, count: 0)
        }
        w.count += 1
        windows[k] = w
        var passed = request
        let reset = max(Int(w.start + seconds - t + 0.999), 1)
        passed.values["web.rate"] = "{requests},{max(requests - w.count, 0)},{reset}"
        if w.count > requests {
            var r = status(429)
            r = r.withHeader("Retry-After", "{reset}")
            r = r.withHeader("RateLimit-Limit", "{requests}")
            r = r.withHeader("RateLimit-Remaining", "0")
            r = r.withHeader("RateLimit-Reset", "{reset}")
            return Step.stop(response: r)
        }
        Step.next(request: passed)
    }, after: { request, response in
        let parts = (request.values["web.rate"] ?? "").split(",")
        if parts.count != 3 {
            return response
        }
        response.withHeader("RateLimit-Limit", parts[0]).withHeader("RateLimit-Remaining", parts[1])
            .withHeader("RateLimit-Reset", parts[2])
    })
}

// The client's IP address, or its /64 network for IPv6: the default key
// for `rateLimit`.
fn clientIP(_ request: Request) -> String {
    ipNetwork(request.ip)
}

// An IPv4 address as it is; an IPv6 address as its first four groups.
fn ipNetwork(_ ip: String) -> String {
    if !ip.contains(":") {
        return ip
    }
    var groups: [String] = []
    if let gap = ip.find("::") {
        let left = ip.substring(from: 0, to: gap).split(":").filter { g in !g.isEmpty }
        let right = ip.substring(from: gap + 2, to: ip.count).split(":").filter { g in !g.isEmpty }
        groups = left
        var fill = 8 - left.count - right.count
        while fill > 0 {
            groups.append("0")
            fill -= 1
        }
        groups += right
    } else {
        groups = ip.split(":")
    }
    var first: [String] = []
    for g in groups.slice(from: 0, to: 4) {
        let trimmed = g.lowercase().trimStart()
        var t = trimmed
        while t.count > 1 && t.hasPrefix("0") {
            t = t.substring(from: 1, to: t.count)
        }
        first.append(t)
    }
    first.joined(separator: ":") + "::/64"
}

// ---- Proxies ----

// For a server behind a proxy (Caddy, nginx) that does HTTPS: when a
// request comes from one of the `trusted` addresses, `request.ip` becomes
// the client's address from X-Forwarded-For, and `request.secure` says
// whether the client used HTTPS (X-Forwarded-Proto). Put it first.
public fn proxy(trusted: [String] = ["127.0.0.1", "::1"]) -> Middleware {
    onRequest { request in
        if !trusted.contains(request.ip) {
            return Step.next(request: request)
        }
        var passed = request
        // From the right: each trusted proxy added the address it got the
        // request from; the first one that isn't a proxy is the client.
        let forwarded = (request.header("x-forwarded-for") ?? "").split(",").map { a in a.trim() }.filter { a in !a.isEmpty }
        var i = forwarded.count - 1
        while i >= 0 {
            let address = hostOnly(forwarded[i])
            passed.ip = address
            if !trusted.contains(address) {
                break
            }
            i -= 1
        }
        let protos = (request.header("x-forwarded-proto") ?? "").split(",")
        let proto = protos[protos.count - 1].trim().lowercase()
        if proto == "https" {
            passed.secure = true
        } else if proto == "http" {
            passed.secure = false
        }
        Step.next(request: passed)
    }
}

// An address without its port: "1.2.3.4:80" is "1.2.3.4", "[::1]:80" is
// "::1"; a bare IPv6 address stays as it is, and an IPv4 address written
// as IPv6 ("::ffff:1.2.3.4") is the IPv4 address.
fn hostOnly(_ address: String) -> String {
    let a = withoutPort(address.trim())
    if a.lowercase().hasPrefix("::ffff:") && a.contains(".") {
        return a.substring(from: 7, to: a.count)
    }
    a
}

fn withoutPort(_ a: String) -> String {
    if a.hasPrefix("[") {
        if let close = a.find("]") {
            return a.substring(from: 1, to: close)
        }
        return a
    }
    if a.occurrences(of: ":") == 1 {
        return a.substring(from: 0, to: a.find(":") ?? a.count)
    }
    a
}
