// An example of web: a small notes site on four worker threads. Pages
// from templates with a layout, a form that adds notes, a JSON API, live
// updates over a WebSocket, a stylesheet from a folder, and signing in:
// hashed passwords checked on another thread, server-side sessions, CSRF
// tokens in the forms, and a limit on sign-in attempts. Notes are kept in
// memory, in a `Shared` value all the workers see.
//
// Run it from the library's folder: `tessel run examples/notes`, then
// open http://127.0.0.1:8080/ and sign in as "ann" with the password
// "tessel". Set NOTES_SECRET to a long random text for a real server.
//
// Author: Alexius Academia
// Date: 2026-11-21

import "../.."

struct Note {
    id: Int
    text: String
    author: String
}

struct HomePage {
    title: String
    user: String
    notes: [Note]
    csrf: String
    error: String = ""
}

// The notes, for every worker.
let notes = Shared([Note(id: 1, text: "Try adding a note", author: "web")])
let nextId = Shared(2)

// Names and password hashes; a real site keeps them in a database.
let users = ["ann": web.hashPassword("tessel")]

// The site, as each worker makes it.
fn routes() -> web.Router {
    let secret = environment("NOTES_SECRET") ?? "change me: a long random text"
    var pages = web.Templates()
    match web.loadTemplates(joinPath(appFolder(), "views")) {
        .ok(loaded) -> { pages = loaded }
        .failure(e) -> {
            printError(e.message)
            exit(1)
        }
    }
    let sessions = web.memoryStore()

    var router = web.Router()
    router.use(web.proxy())
    router.use(web.logger())
    router.use(web.securityHeaders())
    router.use(web.sessions(secret: secret, store: sessions))
    router.files("/static", folder: joinPath(appFolder(), "public"))

    // The pages and their forms, with CSRF tokens.
    var site = web.Router()
    site.use(web.csrf(secret: secret))
    site.get("/") { r in
        let page = HomePage(title: "Notes", user: r.session["user"] ?? "", notes: notes.get().reversed(),
                            csrf: web.csrfField(r), error: r.queryValue("error") ?? "")
        web.page(pages, "home", page, layout: "layout")
    }
    site.post("/notes") { r in
        let user = r.session["user"] ?? ""
        let text = (r.form()["text"] ?? "").trim()
        if user.isEmpty {
            return web.redirect("/?error=Sign+in+first", status: 303)
        }
        if text.isEmpty {
            return web.redirect("/?error=Write+something", status: 303)
        }
        let id = nextId.update { n in n + 1 } - 1
        notes.update { list in list + [Note(id: id, text: text, author: user)] }
        web.redirect("/", status: 303)
    }
    site.post("/logout") { r in
        web.redirect("/", status: 303).withSession([:])
    }

    // Signing in: at most 5 tries a minute from one address, and the
    // password is checked on another thread so other requests go on.
    var login = web.Router()
    login.use(web.rateLimit(requests: 5, seconds: 60))
    login.later("POST", "/login") { r, reply in
        let form = r.form()
        let name = (form["name"] ?? "").trim()
        let hash = users[name] ?? "none"
        web.checkPasswordLater(form["password"] ?? "", hash) { ok in
            if ok {
                reply(web.redirect("/", status: 303).withSession(["user": name], renew: true))
            } else {
                reply(web.redirect("/?error=Wrong+name+or+password", status: 303))
            }
        }
    }
    site.mount("", login)
    router.mount("", site)

    // The same notes as JSON, for programs.
    var api = web.Router()
    api.use(web.cors())
    api.get("/notes") { r in web.json(notes.get()) }
    // How many notes there are, sent again whenever it changes.
    api.get("/live") { r in
        web.webSocket(onOpen: { ws in
            var last = -1
            var timer = 0
            timer = every(seconds: 0.5) {
                let count = notes.get().count
                if count != last {
                    last = count
                    if !ws.send("{count}") {
                        stopTimer(timer)
                    }
                }
            }
        }, onMessage: { ws, text in })
    }
    api.get("/notes/:id") { r in
        for note in notes.get() {
            if "{note.id}" == r.param("id") {
                return web.json(note)
            }
        }
        web.json(["error": "no note {r.param("id")}"], status: 404)
    }
    router.mount("/api", api)

    router
}

fn main() {
    let port = Int(environment("PORT") ?? "") ?? 8080
    let server = web.serveWorkers(routes, port: port, workers: 4)
    if server == -1 {
        print("can't serve: port {port} is taken")
        return
    }
    print("Notes at http://127.0.0.1:{tcpPort(server)}/")
}
