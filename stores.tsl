// web: where server-side sessions are kept: in memory, or in a SQLite
// database. A store is a set of functions, so a program can make its own
// (for another database) by filling them in.
//
// Author: Alexius Academia
// Date: 2026-11-21

// A session's values and when it ends (see `now()`).
public struct StoredSession {
    values: [String: String]
    expires: Float
}

// Where sessions are kept, by id.
public struct SessionStore {
    load: fn(String) -> StoredSession?
    save: fn(String, StoredSession)
    remove: fn(String)
    // Ends every session whose values pass the test, and says how many.
    removeWhere: fn(fn([String: String]) -> Bool) -> Int
    // The sessions there are now (ended ones aren't counted).
    count: fn() -> Int
    // Saves a session that's there already, at once: false (and nothing
    // saved) if it isn't there any more. Optional: without it, `sessions`
    // looks with `load`, then saves.
    replace: (fn(String, StoredSession) -> Bool)? = nil
}

// How many parts the shared tables are in: a change copies and locks one
// part, not all of them.
let shardCount = 64

// `shardCount` empty tables of `T`s by key (`sample` only gives the type).
fn sharded<T>(_ sample: T) -> [Shared<[String: T]>] {
    var parts: [Shared<[String: T]>] = []
    for _ in 0..shardCount {
        let empty: [String: T] = [:]
        parts.append(Shared(empty))
    }
    parts
}

// Which part a key is in (FNV-1a of its bytes).
fn shardOf(_ key: String) -> Int {
    let d = Data(text: key)
    var h = 2166136261
    for i in 0..d.count {
        h = ((h ^ d[i]) * 16777619) % 4294967296
    }
    h % shardCount
}

// The sessions of every `memoryStore`, for all threads: by store name and
// id ("sessions|id"), in parts.
let sessionShards = sharded(StoredSession(values: [:], expires: 0))

// Sessions in memory: they end when the program does. Stores with the same
// `name` are the same sessions, so a server's workers, each making its own
// store, all see every session. At most about `limit` are kept: past it,
// the ones nearest their end go first.
public fn memoryStore(limit: Int = 100000, name: String = "sessions") -> SessionStore {
    let prefix = name + "|"
    let share = max(limit / shardCount, 16)
    SessionStore(load: { id in
        sessionShards[shardOf(id)].get()[prefix + id]
    }, save: { id, session in
        sessionShards[shardOf(id)].update { all in
            var items = all
            items[prefix + id] = session
            if items.count > share || random(0..64) == 0 {
                pruneSessions(items, prefix, share)
            } else {
                items
            }
        }
    }, remove: { id in
        sessionShards[shardOf(id)].update { all in
            var items = all
            items[prefix + id] = nil
            items
        }
    }, removeWhere: { test in
        var removed = 0
        for part in sessionShards {
            part.update { all in
                var items = all
                for (k, s) in all {
                    if k.hasPrefix(prefix) && test(s.values) {
                        items[k] = nil
                        removed += 1
                    }
                }
                items
            }
        }
        removed
    }, count: {
        let t = now()
        var n = 0
        for part in sessionShards {
            for (k, s) in part.get() {
                if k.hasPrefix(prefix) && s.expires > t {
                    n += 1
                }
            }
        }
        n
    }, replace: { id, session in
        // (Only if it's still there: a session ended meanwhile stays ended.)
        var kept = false
        sessionShards[shardOf(id)].update { all in
            if all[prefix + id] == nil {
                return all
            }
            var items = all
            items[prefix + id] = session
            kept = true
            items
        }
        kept
    })
}

// A part's sessions without the ended ones of the store `prefix`, and, if
// it still has more than `share` of them, without those nearest their end.
fn pruneSessions(_ items: [String: StoredSession], _ prefix: String, _ share: Int) -> [String: StoredSession] {
    let t = now()
    var kept = items
    for (k, s) in items {
        if k.hasPrefix(prefix) && s.expires <= t {
            kept[k] = nil
        }
    }
    let mine = kept.keys.filter { k in k.hasPrefix(prefix) }
    if mine.count > share {
        let order = mine.sorted(by: { x, y in (kept[x]?.expires ?? 0) < (kept[y]?.expires ?? 0) })
        for k in order.slice(from: 0, to: mine.count - share * 9 / 10) {
            kept[k] = nil
        }
    }
    kept
}

// Sessions in a table of a SQLite database (made if it isn't there), so
// they last when the server restarts. `table` is a plain name: letters,
// digits and `_`.
public fn databaseStore(_ path: String, table: String = "web_sessions") -> Result<SessionStore> {
    for c in table.characters {
        if !"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_".contains(c) {
            return Result.failure(error: Error("\"{table}\" can't be a table name: use letters, digits and _"))
        }
    }
    var db = try openDatabase(path)
    // (A server's workers each open the file: one waits for another's write.)
    match db.query("PRAGMA busy_timeout = 5000") {
        .ok(_) -> {}
        .failure(_) -> {}
    }
    try db.execute("CREATE TABLE IF NOT EXISTS {table} (id TEXT PRIMARY KEY, data TEXT NOT NULL, expires REAL NOT NULL)")
    try db.execute("DELETE FROM {table} WHERE expires < ?", [now()])
    let store = SessionStore(load: { id in
        match db.query("SELECT data, expires FROM {table} WHERE id = ?", [id]) {
            .ok(rows) -> {
                if rows.isEmpty {
                    return nil
                }
                let values: [String: String]? = fromJson(rows[0].text("data"))
                if let v = values {
                    return StoredSession(values: v, expires: rows[0].float("expires"))
                }
                nil
            }
            .failure(e) -> {
                printError("web: can't read a session: {e.message}")
                nil
            }
        }
    }, save: { id, session in
        run(db, "INSERT OR REPLACE INTO {table} (id, data, expires) VALUES (?, ?, ?)",
            [id, toJson(session.values), session.expires])
        if random(0..100) == 0 {
            run(db, "DELETE FROM {table} WHERE expires < ?", [now()])
        }
    }, remove: { id in
        run(db, "DELETE FROM {table} WHERE id = ?", [id])
    }, removeWhere: { test in
        var removed = 0
        match db.query("SELECT id, data FROM {table}") {
            .ok(rows) -> {
                for row in rows {
                    let values: [String: String] = fromJson(row.text("data")) ?? [:]
                    if test(values) {
                        run(db, "DELETE FROM {table} WHERE id = ?", [row.text("id")])
                        removed += 1
                    }
                }
            }
            .failure(e) -> printError("web: can't read the sessions: {e.message}")
        }
        removed
    }, count: {
        match db.query("SELECT COUNT(*) AS n FROM {table} WHERE expires > ?", [now()]) {
            .ok(rows) -> if rows.isEmpty { 0 } else { rows[0].int("n") }
            .failure(_) -> 0
        }
    }, replace: { id, session in
        match db.execute("UPDATE {table} SET data = ?, expires = ? WHERE id = ?", [toJson(session.values), session.expires, id]) {
            .ok(changed) -> changed > 0
            .failure(e) -> {
                printError("web: can't save a session: {e.message}")
                false
            }
        }
    })
    Result.ok(value: store)
}

// Runs SQL that changes the database, saying on the error output if it
// can't.
fn run(_ db: Database, _ sql: String, _ values: [SqlValue] = []) {
    match db.execute(sql, values) {
        .ok(_) -> {}
        .failure(e) -> printError("web: the session store can't save: {e.message}")
    }
}
